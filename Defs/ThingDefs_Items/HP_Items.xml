<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Soul essence: the core resource. Fuel, ingredient, currency of the damned. -->
  <ThingDef ParentName="ResourceBase">
    <defName>HP_SoulEssence</defName>
    <label>soul essence</label>
    <description>The bound remnant of a human soul, a faintly warm, faintly humming vapour held in a glass phial. It burns without consuming anything, and it binds into metal. Nobody who works with it for long sleeps well.

Volatile. Fire or a heavy blow sets a stack off in a burst of loose souls that drops everyone nearby, and bigger stacks burst wider. Spread your stock.</description>
    <graphicData>
      <texPath>Things/Item/HP_SoulEssence</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>12</MarketValue>
      <Mass>0.05</Mass>
      <!-- Not 0, or fire could never reach it and set it off. -->
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <!-- Volatile stockpiles: chemfuel's radius rule, but bursts at once on the damage event (no ticking wick).
           A full stack of 75 bursts about 3.8 cells wide. -->
      <li Class="HollowPawns.CompProperties_VolatileEssence">
        <explosiveRadius>1.5</explosiveRadius>
        <explosiveExpandPerStackcount>0.03</explosiveExpandPerStackcount>
        <burstHitPointsPercent>0.5</burstHitPointsPercent>
        <extraInspectStringKey>HP_VolatileInspect</extraInspectStringKey>
      </li>
    </comps>
  </ThingDef>

  <!-- Soulsteel: plasteel with a soul bound into it. Buffed 23 Oct to sit well above plasteel
       (Aaron: closer to Metasteel, which is Sharp 7 / Blunt 2): stuffed armour from it caps out
       against most blades and bullets, and it makes vicious blades. Plasteel: 1.14 / 0.55 / 0.65. -->
  <ThingDef ParentName="ResourceBase">
    <defName>HP_Soulsteel</defName>
    <label>soulsteel</label>
    <description>Plasteel with soul essence bound through it. Far harder and lighter than plasteel itself, it barely notices a bullet and holds an edge that cuts bone like cloth. Cold to the touch, and it never quite stops ringing after it is struck.</description>
    <graphicData>
      <texPath>Things/Item/HP_Soulsteel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <statBases>
      <MarketValue>30</MarketValue>
      <Mass>0.25</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <StuffPower_Armor_Sharp>4</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>1.6</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>1.2</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>6</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>3</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.8</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.3</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <commonality>0</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <color>(98,196,206)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>5.0</MaxHitPoints>
        <Beauty>1.5</Beauty>
        <Flammability>0</Flammability>
        <WorkToMake>2.4</WorkToMake>
        <WorkToBuild>2.4</WorkToBuild>
        <MeleeWeapon_CooldownMultiplier>0.85</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <!-- Soulweave: cloth with essence bound through it. A fabric, so any vanilla clothing or
       fabric armour can be made from it; this replaced the six soul apparel sets (23 Oct).
       Vanilla hyperweave for scale: Sharp 2.0, Blunt 0.54, Heat 2.88, insulation 26/26. -->
  <ThingDef ParentName="ResourceBase">
    <defName>HP_Soulweave</defName>
    <label>soulweave</label>
    <description>Cloth with soul essence bound through every thread. It moves like silk, hardens like plate when something tries to cut it, and it is always a little cold. Better than hyperweave against blades and bullets, and nearly impossible to wear out.</description>
    <graphicData>
      <texPath>Things/Item/HP_Soulweave</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <burnableByRecipe>false</burnableByRecipe>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <MarketValue>12</MarketValue>
      <Mass>0.03</Mass>
      <Flammability>0.1</Flammability>
      <DeteriorationRate>0.3</DeteriorationRate>
      <StuffPower_Armor_Sharp>2.6</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.8</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>2.2</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>32</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>20</StuffPower_Insulation_Heat>
    </statBases>
    <thingCategories>
      <li>Textiles</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Fabric</li>
      </categories>
      <commonality>0</commonality>
      <color>(150,205,212)</color>
      <statFactors>
        <Flammability>0.1</Flammability>
        <MaxHitPoints>3.0</MaxHitPoints>
        <Beauty>4</Beauty>
        <WorkToMake>1.5</WorkToMake>
      </statFactors>
    </stuffProps>
  </ThingDef>

</Defs>
