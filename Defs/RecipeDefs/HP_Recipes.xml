<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Crucible: harvest the lingering soul from a human corpse. The corpse isn't destroyed:
       the worker marks its soul taken and leaves the husk for haulers. -->
  <RecipeDef>
    <defName>HP_HarvestCorpseSoul</defName>
    <label>harvest soul from corpse</label>
    <description>Draw the lingering soul out of a human corpse and bind it as essence: 8 from a fresh corpse, 5 from a rotting one, 2 from a desiccated one. The soulless husk is left behind. Corpses whose soul has already been taken are useless here.</description>
    <workerClass>HollowPawns.RecipeWorker_HarvestCorpseSoul</workerClass>
    <jobString>Harvesting soul.</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <recipeUsers>
      <li>HP_SoulCrucible</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>HP_AllowSoulless</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>AllowCorpsesColonist</li>
      </specialFiltersToDisallow>
    </defaultIngredientFilter>
    <!-- No fixed products: RecipeWorker_HarvestCorpseSoul drops 8 essence from a fresh corpse,
         5 from a rotting one, 2 from a desiccated one (SoulUtility.DeadSoulYield). -->
    <researchPrerequisite>HP_SoulExtraction</researchPrerequisite>
  </RecipeDef>

  <!-- Bone altar: the crude corpse harvest. No power, no research: half the crucible's essence
       (4 / 3 / 1, rounded up) and three times the corruption. RecipeWorker_HarvestCorpseSoulCrude. -->
  <RecipeDef>
    <defName>HP_HarvestCorpseSoulCrude</defName>
    <label>gut soul from corpse</label>
    <description>Open a human corpse on the altar and dig out what's left of its soul by hand. Crude and wasteful: 4 essence from a fresh corpse, 3 from a rotting one, 1 from a desiccated one, and the ground around the altar sours badly. The soulless husk is left behind.</description>
    <workerClass>HollowPawns.RecipeWorker_HarvestCorpseSoulCrude</workerClass>
    <jobString>Gutting a soul.</jobString>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>ButcherFlesh</effectWorking>
    <soundWorking>Recipe_ButcherCorpseFlesh</soundWorking>
    <recipeUsers>
      <li>HP_BoneAltar</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>HP_AllowSoulless</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesHumanlike</li>
      </categories>
      <specialFiltersToDisallow>
        <li>AllowCorpsesColonist</li>
      </specialFiltersToDisallow>
    </defaultIngredientFilter>
  </RecipeDef>

  <!-- Crucible: purge corrupted essence into clean. Twice the essence, but the worker may be
       cursed for it (RecipeWorker_PurgeCorruption, 33% per batch). -->
  <RecipeDef>
    <defName>HP_PurgeCorruption</defName>
    <label>purge corrupted essence</label>
    <description>Burn the corruption out of demon essence. Each corrupted phial gives two clean ones, but the work is dangerous: whoever does it may be cursed.</description>
    <workerClass>HollowPawns.RecipeWorker_PurgeCorruption</workerClass>
    <jobString>Purging corrupted essence.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <recipeUsers>
      <li>HP_SoulCrucible</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>HP_CorruptedEssence</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>HP_CorruptedEssence</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HP_SoulEssence>10</HP_SoulEssence>
    </products>
    <researchPrerequisite>HP_SoulExtraction</researchPrerequisite>
  </RecipeDef>

  <!-- Crucible: bind essence into steel. -->
  <RecipeDef>
    <defName>HP_ForgeSoulsteel</defName>
    <label>forge soulsteel</label>
    <description>Bind soul essence through molten plasteel to make soulsteel.</description>
    <jobString>Forging soulsteel.</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <recipeUsers>
      <li>HP_SoulCrucible</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>HP_SoulEssence</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>HP_SoulEssence</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HP_Soulsteel>10</HP_Soulsteel>
    </products>
    <researchPrerequisite>HP_SoulExtraction</researchPrerequisite>
  </RecipeDef>

</Defs>
