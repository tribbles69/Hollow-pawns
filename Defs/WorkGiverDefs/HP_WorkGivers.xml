<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Without this no pawn ever works the crucible's bills: a bench is only worked if a work giver
       names it. Crafting, like vanilla's electric smelter, covers everything made there
       (corpse harvest, soulsteel, soul weapons and ammo). -->
  <WorkGiverDef>
    <defName>HP_DoBillsSoulCrucible</defName>
    <label>work at the soul crucible</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Crafting</workType>
    <priorityInType>80</priorityInType>
    <fixedBillGiverDefs>
      <li>HP_SoulCrucible</li>
    </fixedBillGiverDefs>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- The bone altar's corpse bills. Its own giver class waits while a prisoner is on the altar. -->
  <WorkGiverDef>
    <defName>HP_DoBillsBoneAltar</defName>
    <label>gut souls at the bone altar</label>
    <giverClass>HollowPawns.WorkGiver_DoBillBoneAltar</giverClass>
    <workType>Crafting</workType>
    <priorityInType>79</priorityInType>
    <fixedBillGiverDefs>
      <li>HP_BoneAltar</li>
    </fixedBillGiverDefs>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
