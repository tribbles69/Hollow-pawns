<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Soul shock: stacks with every soul blast. Drags consciousness down until the
       target collapses, alive. Fades in under a day, so prisoners recover. -->
  <HediffDef>
    <defName>HP_SoulShock</defName>
    <label>soul shock</label>
    <description>The soul has been struck and is reeling. Thought and movement come slowly, and enough of it leaves the body collapsed but still breathing. It fades on its own.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.47, 0.86, 0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>rattled</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.30</minSeverity>
        <label>reeling</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.60</minSeverity>
        <label>fraying</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.45</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>severed</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
