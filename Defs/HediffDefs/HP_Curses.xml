<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Curses. Marked, rotting luck and soul-sick are rolled by demon hits (CurseUtility, 10% per
       damaging hit) and by purging corrupted essence; they fade over 4 days, and a fresh curse of
       the same kind resets the clock. Hollowed comes only from wearing a cursed idol, and lasts
       exactly as long as the idol is worn (CompProperties_CauseHediff_Apparel). -->

  <HediffDef Name="HP_CurseBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.3, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.25</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="HP_CurseBase">
    <defName>HP_Curse_Marked</defName>
    <label>curse: marked</label>
    <description>Something has put a mark on this person's soul, and the world seems to aim for it. They take more damage from every source. It fades in a few days.</description>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.25</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="HP_CurseBase">
    <defName>HP_Curse_RottingLuck</defName>
    <label>curse: rotting luck</label>
    <description>Everything this person touches goes slightly wrong. They work slower, and their nerves are frayed. It fades in a few days.</description>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>0.85</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>0.06</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="HP_CurseBase">
    <defName>HP_Curse_SoulSick</defName>
    <label>curse: soul-sick</label>
    <description>A sickness of the soul rather than the body. The person is always hungry, slow to fight off disease, and never quite all there. It fades in a few days.</description>
    <stages>
      <li>
        <hungerRateFactor>1.3</hungerRateFactor>
        <statFactors>
          <ImmunityGainSpeed>0.8</ImmunityGainSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Hollowed: from the cursed idol only. No fade: it lasts while the idol is worn. -->
  <HediffDef>
    <defName>HP_Curse_Hollowed</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>curse: hollowed</label>
    <description>The idol is feeding on this person's soul. They feel scooped out: dull, joyless, quick to break. It lasts as long as they wear it.</description>
    <defaultLabelColor>(0.75, 0.3, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <statOffsets>
          <MentalBreakThreshold>0.08</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
