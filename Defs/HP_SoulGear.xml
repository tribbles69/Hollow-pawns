<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Lower-tech soul weapons (4.13) =====================
       Soul bow (vanilla bows have no ammo, so the soul is in the bow; under CE it fires real soul
       arrows, see Mods/CombatExtended), bone fetish (cuts the reap chance against its wearer through
       HP_ReapWard) and wraith lantern (SoulGear.cs). -->

  <DamageDef ParentName="Arrow">
    <defName>HP_SoulArrow</defName>
    <label>soul arrow</label>
    <deathMessage>{0} was shot through by a soul arrow.</deathMessage>
    <hediff>Stab</hediff>
    <additionalHediffs>
      <li>
        <hediff>HP_SoulShock</hediff>
        <!-- 13 damage = about 0.16 shock: lighter than a soul gun, but every arrow adds up. -->
        <severityPerDamageDealt>0.012</severityPerDamageDealt>
      </li>
    </additionalHediffs>
  </DamageDef>

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>HP_Arrow_Soul</defName>
    <label>soul arrow</label>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150,230,240)</color>
    </graphicData>
    <projectile>
      <damageDef>HP_SoulArrow</damageDef>
      <damageAmountBase>13</damageAmountBase>
      <stoppingPower>1</stoppingPower>
      <speed>56</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>HP_SoulBow</defName>
    <label>soul bow</label>
    <description>A recurve bow strung with gut soaked in soul essence. Every arrow it looses carries a little of that soul with it: hits leave soul shock on top of the wound, so a volley can drop someone without killing them.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/BowRecurve</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150,200,210)</color>
    </graphicData>
    <soundInteract>Bow_Recurve</soundInteract>
    <costList>
      <WoodLog>40</WoodLog>
      <HP_SoulEssence>5</HP_SoulEssence>
    </costList>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>1.3</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>HP_SoulBow</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>RangedLight</li>
    </weaponClasses>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <researchPrerequisite>RecurveBow</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>521</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>HP_Arrow_Soul</defaultProjectile>
        <warmupTime>1.45</warmupTime>
        <range>25.9</range>
        <soundCast>Bow_Recurve</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
  </ThingDef>

  <!-- Bone fetish: a charm on a cord. Halves the chance a reaper tears the wearer's soul out. -->
  <ThingDef ParentName="ApparelBase">
    <defName>HP_BoneFetish</defName>
    <label>bone fetish</label>
    <description>Finger bones strung on gut around a knot of hair, worn at the throat. The soul it guards is harder to tear loose: a reaper's chance against the wearer is halved.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/HP_BoneFetish</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <WoodLog>10</WoodLog>
      <HP_SoulEssence>3</HP_SoulEssence>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <displayPriority>600</displayPriority>
    </recipeMaker>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToMake>2500</WorkToMake>
      <Mass>0.2</Mass>
      <Flammability>0.6</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <HP_ReapWard>0.5</HP_ReapWard>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Neck</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <careIfWornByCorpse>false</careIfWornByCorpse>
    </apparel>
    <generateCommonality>0</generateCommonality>
  </ThingDef>

  <!-- Wraith lantern: unshutter it and enemies nearby break and run. -->
  <ThingDef ParentName="ApparelBase">
    <defName>HP_WraithLantern</defName>
    <label>wraith lantern</label>
    <description>An iron lantern with a shuttered face, hung from the belt. There is a soul burning in it instead of a wick. Open the shutter and every enemy within nine cells who can see it is soul-shocked, and about half of them break and run. It needs a day to recover after.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/HP_WraithLantern</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <Steel>30</Steel>
      <HP_SoulEssence>15</HP_SoulEssence>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>HP_SoulExtraction</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>601</displayPriority>
    </recipeMaker>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>5000</WorkToMake>
      <Mass>1.5</Mass>
      <Flammability>0</Flammability>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <comps>
      <li Class="HollowPawns.CompProperties_WraithLantern">
        <radius>8.9</radius>
        <fleeChance>0.5</fleeChance>
        <soulShock>0.1</soulShock>
        <cooldownTicks>60000</cooldownTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
