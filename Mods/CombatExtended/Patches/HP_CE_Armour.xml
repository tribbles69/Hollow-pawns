<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Reliquary armour under CE: a notch under CE's marine armour (Sharp 20, Blunt 45, Bulk 100,
       WornBulk 15, Mass 50; from CE's Patches/Core/ThingDefs_Misc/Apparel_Various.xml). Unpowered, so
       heavier to move in. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="HP_ReliquaryArmour"]/statBases</xpath>
    <value>
      <Bulk>90</Bulk>
      <WornBulk>15</WornBulk>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="HP_ReliquaryArmour"]/statBases/Mass</xpath>
    <value>
      <Mass>45</Mass>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="HP_ReliquaryArmour"]/statBases/MaxHitPoints</xpath>
    <value>
      <MaxHitPoints>450</MaxHitPoints>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="HP_ReliquaryArmour"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>18</ArmorRating_Sharp>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="HP_ReliquaryArmour"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>40</ArmorRating_Blunt>
    </value>
  </Operation>

  <!-- The shroud: CE's duster numbers (bulk and worn bulk only; armour comes from the stuff). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="HP_ReapersShroud"]/statBases</xpath>
    <value>
      <Bulk>7.5</Bulk>
      <WornBulk>2</WornBulk>
    </value>
  </Operation>

</Patch>
