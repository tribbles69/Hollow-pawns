<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Soul pipes and vats (4.14) =====================
       Only loads with Vanilla Expanded Framework (LoadFolders.xml). All XML, on VEF's PipeSystem,
       copied from Vanilla Chemfuel Expanded's ChemfuelNet.xml. Essence goes in at a drain, sits in
       vats, comes out at a tap, and tops up anything that burns essence as fuel on its own (soul
       generator, essence shrine, fountain of youth, soul cradle) through linkToRefuelables.
       No soulsteel processor: VEF's processor can't make plasteel-style stuff from a resource. -->

  <DesignationCategoryDef>
    <defName>HP_SoulPipes</defName>
    <label>soul pipes</label>
    <description>Pipes, vats, drains and taps that move soul essence around.</description>
    <order>351</order>
    <specialDesignatorClasses>
      <li>Designator_Cancel</li>
      <li>Designator_Deconstruct</li>
    </specialDesignatorClasses>
  </DesignationCategoryDef>

  <PipeSystem.PipeNetDef>
    <defName>HP_SoulNet</defName>
    <resource>
      <name>Soul essence</name>
      <unit>ess</unit>
      <color>(0.47, 0.86, 0.9)</color>
      <onlyShowStored>True</onlyShowStored>
      <offTexPath>Things/Item/HP_SoulEssence</offTexPath>
    </resource>
    <pipeDefs>
      <li>HP_SoulPipe</li>
    </pipeDefs>
    <designator>
      <deconstructIconPath>UI/Designators/Deconstruct</deconstructIconPath>
      <designationCategoryDef>HP_SoulPipes</designationCategoryDef>
    </designator>
    <overlayOptions>
      <overlayColor>(0.47, 0.86, 0.9)</overlayColor>
    </overlayOptions>
    <linkToRefuelables>
      <li>
        <thing>HP_SoulEssence</thing>
        <ratio>1</ratio>
      </li>
    </linkToRefuelables>
  </PipeSystem.PipeNetDef>

  <ThingDef ParentName="BuildingBase">
    <defName>HP_SoulPipe</defName>
    <label>soul pipe</label>
    <description>Glass-lined steel pipe that carries soul essence between drains, vats, taps and anything that burns essence. A cracked pipe leaks, and what leaks out fouls the ground.</description>
    <thingClass>PipeSystem.Building_Pipe</thingClass>
    <category>Building</category>
    <tickerType>Rare</tickerType>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(120,220,230)</color>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom3</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
      <canConstructInCorner>true</canConstructInCorner>
    </building>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>40</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <costList>
      <Steel>2</Steel>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>HP_SoulNet</pipeNet>
      </li>
    </comps>
    <placeWorkers>
      <li>PipeSystem.PlaceWorker_Pipe</li>
    </placeWorkers>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>HP_SoulPipes</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites>
      <li>HP_IndustrialHarvest</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>HP_SoulValve</defName>
    <label>soul valve</label>
    <description>Opens or shuts the flow of essence through a soul pipe.</description>
    <thingClass>PipeSystem.Building_PipeValve</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/HP_SoulValve</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <allowWireConnection>false</allowWireConnection>
    </building>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_PipeValve">
        <pipeNet>HP_SoulNet</pipeNet>
        <alwaysLinkToPipes>true</alwaysLinkToPipes>
      </li>
      <li Class="CompProperties_Flickable">
        <commandTexture>Things/Item/HP_SoulEssence</commandTexture>
        <commandLabelKey>HP_SoulValve</commandLabelKey>
        <commandDescKey>HP_SoulValveDesc</commandDescKey>
      </li>
    </comps>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <tickerType>Normal</tickerType>
    <designationCategory>HP_SoulPipes</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>HP_IndustrialHarvest</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- The vat. A broken one doesn't explode like a chemfuel tank; it vents loose souls. -->
  <ThingDef ParentName="BuildingBase">
    <defName>HP_SoulVat</defName>
    <label>soul vat</label>
    <description>A squat steel vat lined with glass, holding soul essence piped in from drains. Draw it off as stacks when you need it, or let the pipes carry it straight to anything that burns essence.\n\nIf it is badly damaged it vents: a burst of loose souls that drops everyone nearby with soul shock.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/HP_SoulVat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.40</fillPercent>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <Steel>120</Steel>
      <HP_SoulEssence>10</HP_SoulEssence>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>HP_SoulNet</pipeNet>
        <storageCapacity>500</storageCapacity>
        <barSize>(1.3, 0.2)</barSize>
        <margin>0.1</margin>
        <centerOffset>(0, 0, 0.2)</centerOffset>
        <extractOptions>
          <texPath>Things/Item/HP_SoulEssence</texPath>
          <labelKey>HP_ExtractEssence</labelKey>
          <descKey>HP_ExtractEssenceDesc</descKey>
          <extractAmount>25</extractAmount>
          <thing>HP_SoulEssence</thing>
          <ratio>1</ratio>
        </extractOptions>
      </li>
      <li Class="PipeSystem.CompProperties_ExplosiveContent">
        <explosiveMaxRadius>7</explosiveMaxRadius>
        <explosiveDamageType>HP_SoulBurst</explosiveDamageType>
        <destroyThingOnExplosionSize>2</destroyThingOnExplosionSize>
        <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
        <wickTicks>70~150</wickTicks>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(120,220,230,0)</glowColor>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>HP_SoulPipes</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>HP_IndustrialHarvest</li>
    </researchPrerequisites>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
  </ThingDef>

  <ThingDef ParentName="FurnitureBase">
    <defName>HP_SoulTap</defName>
    <label>essence tap</label>
    <description>A basin that fills with essence from the soul pipes, as stacks haulers can take away.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Things/Building/HP_SoulTap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
    </costList>
    <building>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>HP_SoulEssence</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>HP_SoulEssence</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>HP_SoulPipes</designationCategory>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <comps>
      <li Class="PipeSystem.CompProperties_ConvertResourceToThing">
        <pipeNet>HP_SoulNet</pipeNet>
        <thing>HP_SoulEssence</thing>
      </li>
    </comps>
    <researchPrerequisites>
      <li>HP_IndustrialHarvest</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="FurnitureBase">
    <defName>HP_SoulDrain</defName>
    <label>essence drain</label>
    <description>A basin that takes essence hauled to it and feeds it into the soul pipes, filling connected vats.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Things/Building/HP_SoulDrain</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>HP_SoulEssence</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>HP_SoulEssence</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>HP_SoulPipes</designationCategory>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <comps>
      <li Class="PipeSystem.CompProperties_ConvertThingToResource">
        <pipeNet>HP_SoulNet</pipeNet>
        <thing>HP_SoulEssence</thing>
      </li>
    </comps>
    <researchPrerequisites>
      <li>HP_IndustrialHarvest</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
