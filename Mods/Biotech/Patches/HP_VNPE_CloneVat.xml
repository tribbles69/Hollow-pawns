<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Vanilla Nutrient Paste Expanded: the clone vat joins the paste pipe net, the way VNPE patches
       vanilla's growth vat. With no carrion or meat next to it, the vat starts a culture on paste and
       draws 4 meals from the pipes as it grows, one per quarter, pausing while the pipes are dry
       (Building_CloneVat and PipeNets in EndlessWar.cs). This folder only loads with Biotech. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Nutrient Paste Expanded</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="HP_CloneVat"]/comps</xpath>
      <value>
        <li Class="PipeSystem.CompProperties_Resource">
          <pipeNet>VNPE_NutrientPasteNet</pipeNet>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
