<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- Each game version loads its own build of the DLL: 1.6/Assemblies (net48, Unity, Harmony 2) or
       1.7/Assemblies (net10.0, Waylith, Harmony 3); both come from the one project in Source/HollowPawns.
       Everything at the root always loads. The Combat Extended folder (soul ammo,
       CE weapon and material patches) only loads when CE is active. The Biotech folder
       (demons, the hell gate, Hell Unbound) only loads with Biotech. The VEF folder
       (soul pipes and vats) only loads with Vanilla Expanded Framework, and the Ideology
       folder (corruption precepts) only with Ideology. -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Ludeon.RimWorld.Biotech">Mods/Biotech</li>
    <li IfModActive="OskarPotocki.VanillaFactionsExpanded.Core">Mods/VEF</li>
    <li IfModActive="Ludeon.RimWorld.Ideology">Mods/Ideology</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>1.7</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Ludeon.RimWorld.Biotech">Mods/Biotech</li>
    <li IfModActive="OskarPotocki.VanillaFactionsExpanded.Core">Mods/VEF</li>
    <li IfModActive="Ludeon.RimWorld.Ideology">Mods/Ideology</li>
  </v1.7>
</loadFolders>
